---
import Section from "@/components/Section.astro";
import {work} from "@cv";
---

<Section>
  <article>
    <header>
      <h2 class="section-title">EXPERIENCIA LABORAL</h2>
    </header>
    <footer>
      {
        work.map(({ name, institution, position, url, startDate, endDate, summary }) => {
          const fmt = (d) => { const [y, m] = d.split('-'); const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic']; return `${meses[+m-1]} ${y}`; };
          const startFmt = fmt(startDate);
          const endFmt = endDate != null ? fmt(endDate) : "Actualidad";

          return (
            <section class="work-entry">
              <header>
                <div>
                  <h3>{institution}</h3>
                  <h4>{position}</h4>
                </div>
                <div>
                  <time datetime={startDate} data-title={startDate}>{startFmt}</time>
                  -
                  <time datetime={startDate} data-title={startDate}>{endFmt}</time>
                </div>
              </header>
            </section>
          );
        })
      }
    </footer>
  </article>
</Section>

<style>
  @reference "tailwindcss";

  .section-title {
    @apply py-0.5 mb-2 text-white bg-[#223558] text-center font-semibold;
  }

  .work-entry {
    @apply mb-2;
  }

  .work-entry header {
    @apply flex justify-between items-start gap-2 mb-1;
  }

  .work-entry h3 {
    font-weight: 500;
    color: #111;
  }

  .work-entry h4 {
    font-weight: 400;
    color: #222;
  }

  .work-entry small {
    color: #555;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    cursor: default;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }

  @media print {
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .section-title {
      background-color: #223558 !important;
      color: white !important;
    }

    h2, h3, h4 {
      color: #555 !important;
    }
  }
</style>
